{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "keymove",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"BETTER_AUTH_URL": "https://keymove.xyz",
		"LICHESS_CLIENT_ID": "keymove.xyz"
	},
	"assets": {
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	},
	"routes": [
		{
			"pattern": "keymove.xyz",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "keymove",
			"database_id": "2cab6412-bc8c-4917-bf3d-a867c71aaf62"
		}
	]
}

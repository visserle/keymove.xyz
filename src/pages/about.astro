---
export const prerender = true;

import Base from "../layouts/Base.astro";
---

<Base
  title="About • keymove.xyz"
  description="About keymove.xyz, a free and open-source collection of beautiful chess compositions: studies, short mates and endgame problems from masters."
>
  <main class="about">
    <img class="about__icon" src="/favicon.svg" alt="" width="80" height="80" />
    <h1 class="about__name">keymove.xyz</h1>
    <p class="about__motto">Chess Compositions for Connoisseurs</p>
    <a class="about__repository" href="https://github.com/visserle/keymove.xyz">
      github.com/visserle/keymove.xyz<svg
        class="about__external-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 4h6v6M20 4l-9 9" />
        <path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" />
      </svg>
    </a>
    <p class="about__thanks">
      With special thanks to <a href="https://lichess.org">lichess.org</a>.
    </p>
  </main>
</Base>
